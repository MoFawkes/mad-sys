<ui:FluentWindow x:Class="AqiClock.App.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Admin — AQI Clock"
        Width="1120"
        Height="780"
        MinWidth="900"
        MinHeight="480"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource CardBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource CardBrush}" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CurrentPeriodBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <ui:TitleBar Title="AQI Clock administration" />
    <DockPanel Grid.Row="1" Margin="22,12,22,22">
        <ui:InfoBar DockPanel.Dock="Top"
                    IsOpen="{Binding HasBanner}"
                    Severity="Error"
                    Title="Administration unavailable"
                    Message="{Binding Banner}"
                    Margin="0,0,0,10" />
        <TabControl IsEnabled="{Binding IsEditable}">
            <TabItem Header="Timetables">
                <Grid DataContext="{Binding Timetables}" Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom">
                            <ui:Button Content="New" Command="{Binding NewTimetableCommand}" Appearance="Primary" Margin="0,2,4,2" />
                            <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="0,2,4,2" />
                            <Button Content="Archive / restore" Command="{Binding ToggleArchiveCommand}" Margin="0,2,4,2" />
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" />
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="16,0,0,0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource ErrorBrush}" />
                            <TextBlock Text="{Binding WarningMessage}" Foreground="{DynamicResource WarningBrush}" />
                            <Border Background="{DynamicResource WarningBackgroundBrush}" CornerRadius="8" Padding="10" Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="Changed remotely just now — " /><Button Content="Reload" Command="{Binding ReloadCommand}" /><Button Content="Overwrite" Command="{Binding OverwriteCommand}" /></StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <Button Content="Add period" Command="{Binding AddPeriodCommand}" />
                            <ui:Button Content="Save" Command="{Binding SaveCommand}" Appearance="Primary" />
                            <Button Content="Cancel" Command="{Binding CancelCommand}" />
                            <ui:Button Content="Delete timetable" Command="{Binding DeleteCommand}" Appearance="Danger" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Periods}" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Start" Binding="{Binding Start}" />
                                <DataGridTextColumn Header="End" Binding="{Binding End}" />
                                <DataGridCheckBoxColumn Header="Lesson?" Binding="{Binding IsLesson}" />
                                <DataGridTemplateColumn Header="Order" Width="Auto" MinWidth="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><ui:Button Content="↑" ToolTip="Move up" Appearance="Transparent" MinWidth="32" Height="32" Padding="4" Margin="2,0" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /><ui:Button Content="↓" ToolTip="Move down" Appearance="Transparent" MinWidth="32" Height="32" Padding="4" Margin="2,0" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header=" " Width="Auto" MinWidth="56"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Button Content="✕" ToolTip="Delete period" Appearance="Danger" MinWidth="32" Height="32" Padding="4" Margin="2,0" Command="{Binding DataContext.RemovePeriodCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Week schedule">
              <DockPanel DataContext="{Binding WeekSchedule}" Margin="10"><TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Text="Each day has a default row that applies to everyone. Use ＋ to add a class-specific row; devices whose class matches use that row instead of the default."/>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Day" Binding="{Binding DayLabel}" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Timetable"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox MinWidth="220" ItemsSource="{Binding DataContext.Timetables, RelativeSource={RelativeSource AncestorType=DataGrid}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TimetableId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Applies to"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox MinWidth="180" ItemsSource="{Binding DataContext.Audiences, RelativeSource={RelativeSource AncestorType=DataGrid}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding AudienceClassId, Mode=TwoWay}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="No school" Command="{Binding DataContext.SetNoSchoolCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /><Button Content="Save" Command="{Binding DataContext.SaveRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /><Button Content="＋" Command="{Binding DataContext.AddRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /><Button Content="✕" Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /><TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
            <TabItem Header="Date overrides">
                <DockPanel DataContext="{Binding Overrides}" Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><ui:Button Content="Add override" Command="{Binding AddCommand}" Appearance="Primary" /><CheckBox Content="Show past" IsChecked="{Binding ShowPast}" Margin="16,0" /></StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" />
                    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" />
                            <DataGridTemplateColumn Header="Timetable / Closed"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><ComboBox MinWidth="220" ItemsSource="{Binding DataContext.Timetables, RelativeSource={RelativeSource AncestorType=DataGrid}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TimetableId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><Button Content="Closed" Command="{Binding DataContext.SetClosedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" />
                            <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><ui:Button Content="Save" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Appearance="Primary" /><ui:Button Content="Delete" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Appearance="Danger" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Classes / Audiences">
              <Grid DataContext="{Binding Classes}" Margin="10">
                <DockPanel><ui:Button DockPanel.Dock="Top" Content="Add class" Command="{Binding AddCommand}" HorizontalAlignment="Left"/>
                  <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}"/>
                  <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Order" Width="90" Binding="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><ui:Button Content="Save" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><ui:Button Content="Delete" Appearance="Danger" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="4,0,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  </DataGrid.Columns></DataGrid></DockPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Student devices">
              <ScrollViewer DataContext="{Binding StudentDevices}">
                <StackPanel Margin="24" MaxWidth="680" HorizontalAlignment="Center">
                  <TextBlock Text="Student join code" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Share this code or QR with students. The app must already be installed before scanning." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,20"/>
                  <Border Padding="18,12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding DisplayCode}" FontFamily="Consolas" FontSize="28" FontWeight="SemiBold" TextAlignment="Center"/>
                  </Border>
                  <Image Source="{Binding QrCode}" Width="220" Height="220" Stretch="Uniform" Margin="0,20,0,20"/>
                  <WrapPanel HorizontalAlignment="Center">
                    <ui:Button Content="Copy code" Command="{Binding CopyCodeCommand}" Margin="4"/>
                    <ui:Button Content="Copy link" Command="{Binding CopyLinkCommand}" Margin="4"/>
                    <ui:Button Content="New code" Command="{Binding RotateCommand}" Margin="4"/>
                    <ui:Button Content="Remove all student devices" Command="{Binding RevokeCommand}" Appearance="Danger" Margin="4"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Announcements">
                <TabControl DataContext="{Binding Announcements}" Margin="10">
                  <TabItem Header="Compose"><ScrollViewer><StackPanel Margin="8">
                    <TextBlock Text="Compose announcement" FontWeight="SemiBold" />
                    <TextBox Text="{Binding Title}" MaxLength="200" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Body}" MaxLength="2000" AcceptsReturn="True" Height="90" Margin="0,8,0,0" />
                    <TextBlock Text="Audience" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,2"/><ComboBox ItemsSource="{Binding Audiences}" SelectedItem="{Binding Audience}" />
                    <ComboBox ItemsSource="{Binding Classes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding AudienceClassId}" Margin="0,6,0,0"/>
                    <TextBlock Text="Update type" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,2"/><ComboBox ItemsSource="{Binding UpdateTypes}" SelectedItem="{Binding UpdateType}"/>
                    <TextBlock Text="Publish date/time (optional)" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,2"/>
                    <StackPanel Orientation="Horizontal"><DatePicker SelectedDate="{Binding PublishAt}" Width="180"/><TextBox Text="{Binding PublishTime}" Width="90" Margin="8,0,0,0" ToolTip="Time in HH:mm format"/></StackPanel>
                    <TextBox Text="{Binding EMasjidLink}" Margin="0,8,0,0" ToolTip="Optional HTTPS e-Masjid link"/>
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Expiry}" Margin="0,8,0,0"/>
                    <ui:Button Content="Publish or schedule" Command="{Binding PublishCommand}" Appearance="Primary" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" />
                  </StackPanel></ScrollViewer></TabItem>
                  <TabItem Header="Active"><ListBox ItemsSource="{Binding Items}"><ListBox.ItemTemplate><DataTemplate><DockPanel><ui:Button DockPanel.Dock="Right" Content="Delete" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Appearance="Danger" /><StackPanel><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding AudienceType}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
                  <TabItem Header="Scheduled &amp; history"><ListBox ItemsSource="{Binding History}"><ListBox.ItemTemplate><DataTemplate><DockPanel><ui:Button DockPanel.Dock="Right" Content="Publish now" IsEnabled="{Binding CanPublishFromHistory}" Command="{Binding DataContext.PublishItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><StackPanel><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="Recent changes"><DockPanel DataContext="{Binding Audit}" Margin="10"><ui:Button DockPanel.Dock="Top" Content="Refresh" Command="{Binding LoadCommand}" Appearance="Primary" HorizontalAlignment="Left" /><TextBlock DockPanel.Dock="Top" Text="{Binding Message}" /><DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" AutoGenerateColumns="True" /></DockPanel></TabItem>
            <TabItem Header="Profiles / Audiences"><DockPanel DataContext="{Binding Users}" Margin="10"><TextBlock DockPanel.Dock="Top" Text="Invitations are managed in the Supabase dashboard for the MVP. Other users' email addresses are not stored in profiles." /><DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True" /><DataGridTextColumn Header="Email" Binding="{Binding Email, Mode=OneWay}" IsReadOnly="True" /><DataGridTemplateColumn Header="Role"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEnabled="{Binding IsEditable}" ItemsSource="{Binding DataContext.Roles, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><DataGridCheckBoxColumn.ElementStyle><Style TargetType="CheckBox"><Setter Property="IsEnabled" Value="{Binding IsEditable}" /></Style></DataGridCheckBoxColumn.ElementStyle></DataGridCheckBoxColumn><DataGridTemplateColumn><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><ui:Button Content="Save" Appearance="Primary" IsEnabled="{Binding IsEditable}" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /><TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></DockPanel></TabItem>
        </TabControl>
    </DockPanel>
    </Grid>
</ui:FluentWindow>
